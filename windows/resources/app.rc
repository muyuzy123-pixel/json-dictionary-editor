 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "muyuzy123-pixel\0"
            VALUE "FileDescription", "JSON 字典编辑器\0"
            VALUE "FileVersion", "1.1.1\0"
            VALUE "InternalName", "JSONDictionaryEditor\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 muyuzy123-pixel\0"
            VALUE "OriginalFilename", "JSONDictionaryEditor.exe\0"
            VALUE "ProductName", "JSON 字典编辑器\0"
            VALUE "ProductVersion", "1.1.1\0"
        END
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "muyuzy123-pixel\0"
            VALUE "FileDescription", "JSON Dictionary Editor\0"
            VALUE "FileVersion", "1.1.1\0"
            VALUE "InternalName", "JSONDictionaryEditor\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 muyuzy123-pixel\0"
            VALUE "OriginalFilename", "JSONDictionaryEditor.exe\0"
            VALUE "ProductName", "JSON Dictionary Editor\0"
            VALUE "ProductVersion", "1.1.1\0"
        END
    END
    BLOCK "VarFileInfo"
